# 開発用の設定の見本（詳細設計書 3章・8章）。秘密の情報は書かない
# 使い方：このファイルを .env にコピーし、php85 artisan key:generate を実行する

APP_NAME="Recipe Box"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 画面（Next.js）の住所。/api は Next.js が転送してくる
APP_URL=http://localhost:3000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ログは1日1ファイル、14日分（詳細設計書 4.8）
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 開発用の MySQL（compose.yaml）
# パスワードはここに書かない。config/database.php が Windows のユーザー環境変数 RECIPE_DB_PASSWORD を読む
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=recipe_app
DB_USERNAME=recipe_app_user
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_ja_0900_as_cs

# セッションは DB に保存。操作しないまま120分で切れる（詳細設計書 4.4）
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum の SPA 認証：ログインのクッキーを使う画面の住所
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# 回数制限の数などは DB に保存（テーブル設計書 3.9）
CACHE_STORE=database

MAIL_MAILER=log

# 本番では EC2 の役割（IAM）で S3 を使うので、鍵は書かない
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
